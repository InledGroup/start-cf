---
import Layout from '../layouts/Layout.astro';
import Clock from '../components/Clock.astro';
import SearchBox from '../components/SearchBox.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import NewsWidget from '../components/NewsWidget.astro';
---

<Layout 
  title="El Buscador Privado Español" 
  description="Start Search: El motor de búsqueda multi-índice hecho en España. Privacidad total, sin rastreo y con resultados de múltiples motores en un solo lugar."
  isHome={true}
>
  <script is:inline>
    // Comprobar si es la primera vez que entra
    if (!localStorage.getItem('start_visited')) {
      // Si viene de la landing, marcamos como visitado y permitimos el acceso
      if (document.referrer.includes('/welcome')) {
        localStorage.setItem('start_visited', 'true');
      } else {
        window.location.href = '/welcome';
      }
    }
  </script>

	<main class="min-h-screen flex flex-col items-center relative w-full overflow-x-hidden">
    <div class="min-h-[90vh] md:h-screen flex flex-col items-center justify-center w-full px-4 pt-10 md:pt-0">
      <Clock />
      <WeatherWidget />
      <SearchBox />

      <!-- CTA Community Section - Ahora justo después del buscador -->
      <section class="flex flex-col items-center text-center space-y-6 animate-fade-in mt-12 mb-8">
        <div class="flex flex-wrap justify-center gap-4">
          <a 
            href="https://github.com/InledGroup/start-cf" 
            target="_blank"
            class="flex items-center gap-3 px-5 py-2.5 glass rounded-2xl hover:bg-white/10 transition-all hover:scale-105 group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/80"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            <span class="text-[10px] font-bold uppercase tracking-widest">Colaborar</span>
          </a>
          
          <button 
            onclick="window.shareApp()"
            class="flex items-center gap-3 px-5 py-2.5 bg-white text-black rounded-2xl hover:bg-white/90 transition-all hover:scale-105 group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            <span class="text-[10px] font-bold uppercase tracking-widest">Recomendar</span>
          </button>
        </div>
      </section>
    </div>
    
    <div class="w-full max-w-6xl px-4 pb-20 mt-10 md:mt-0">
      <NewsWidget />
    </div>
    
    <div class="py-10 opacity-30 text-[10px] text-white uppercase tracking-[0.2em]">
      &copy; 2026 START SEARCH
    </div>
	</main>
</Layout>
