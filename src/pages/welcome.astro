---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bienvenido a Start" isHome={true}>
  <main class="min-h-screen flex flex-col items-center justify-center relative w-full overflow-x-hidden text-white selection:bg-white selection:text-black">
    
    <!-- Beta Badge -->
    <div class="fixed top-6 left-1/2 -translate-x-1/2 z-50">
      <div class="glass px-4 py-1.5 rounded-full border border-white/20 flex items-center gap-2">
        <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-white/80">Beta</span>
      </div>
    </div>

    <!-- Hero Section -->
    <section class="min-h-screen flex flex-col items-center justify-center px-4 text-center z-10">
      <div class="mb-8 animate-fade-in">
        <img 
          src="https://hosted.inled.es/start-simple-blanco-sinfondo.png" 
          alt="Start Logo" 
          class="h-24 md:h-32 object-contain drop-shadow-[0_0_30px_rgba(255,255,255,0.3)]"
        />
      </div>
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter mb-6 bg-gradient-to-b from-white to-white/40 bg-clip-text text-transparent animate-slide-up">
        Busca con libertad.<br/>Sin rastros.
      </h1>
      <p class="text-lg md:text-xl text-white/60 max-w-2xl mb-12 font-light leading-relaxed animate-slide-up delay-100">
        El motor de búsqueda que respeta tu privacidad, combina los mejores índices del mundo y nace de ingeniería española.
      </p>
      <div class="flex flex-col md:flex-row gap-6 animate-slide-up delay-200">
        <a href="/" class="px-10 py-4 bg-white text-black font-bold rounded-2xl hover:bg-white/90 transition-all hover:scale-105 active:scale-95 shadow-[0_0_20px_rgba(255,255,255,0.2)]">
          Empezar a buscar
        </a>
        <a href="#features" class="px-10 py-4 glass text-white font-bold rounded-2xl hover:bg-white/10 transition-all hover:scale-105 active:scale-95">
          Saber más
        </a>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="w-full max-w-6xl px-6 py-20 z-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Privacy -->
        <div class="glass-card p-10 rounded-[2.5rem] border border-white/10 flex flex-col items-start group hover:border-white/30 transition-all duration-500">
          <div class="w-14 h-14 bg-white/5 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-white/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Privacidad Máxima</h3>
          <p class="text-white/50 leading-relaxed font-light">
            No guardamos tus búsquedas, no rastreamos tu IP y no utilizamos cookies de seguimiento. Tu identidad es solo tuya.
          </p>
        </div>

        <!-- Multi-Engine -->
        <div class="glass-card p-10 rounded-[2.5rem] border border-white/10 flex flex-col items-start group hover:border-white/30 transition-all duration-500">
          <div class="w-14 h-14 bg-white/5 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-white/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Multi-índice</h3>
          <p class="text-white/50 leading-relaxed font-light">
            Combinamos los mejores índices (Bing, DDG, Mojeek) para ofrecerte la visión más completa de la web.
          </p>
        </div>

        <!-- Made in Spain -->
        <div class="glass-card p-10 rounded-[2.5rem] border border-white/10 flex flex-col items-start group hover:border-white/30 transition-all duration-500">
          <div class="w-14 h-14 bg-white/5 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-white/10 transition-colors">
            <span class="text-2xl">🇪🇸</span>
          </div>
          <h3 class="text-2xl font-bold mb-4">Made in Spain</h3>
          <p class="text-white/50 leading-relaxed font-light">
            Apostamos por la soberanía tecnológica. Un motor de búsqueda global diseñado íntegramente en España.
          </p>
        </div>
      </div>
    </section>

    <!-- Comparison Table Section -->
    <section class="w-full max-w-6xl px-6 py-20 z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-black mb-6 tracking-tighter">Comparativa honesta</h2>
        <p class="text-white/50 max-w-2xl mx-auto font-light">Analizamos cómo nos situamos frente a los gigantes y otras alternativas de privacidad.</p>
      </div>

      <div class="glass-card rounded-[3rem] border border-white/10 overflow-hidden overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[800px]">
          <thead>
            <tr class="border-b border-white/10 bg-white/5">
              <th class="p-8 text-xs uppercase tracking-[0.2em] text-white/40">Motor</th>
              <th class="p-8 text-xs uppercase tracking-[0.2em] text-white/40 text-center">Rastreo</th>
              <th class="p-8 text-xs uppercase tracking-[0.2em] text-white/40 text-center">Jurisdicción</th>
              <th class="p-8 text-xs uppercase tracking-[0.2em] text-white/40 text-center">Índices</th>
              <th class="p-8 text-xs uppercase tracking-[0.2em] text-white/40 text-center">Soberanía EU</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
              <td class="p-8 flex items-center gap-4">
                <img src="https://www.google.com/s2/favicons?domain=google.com&sz=64" class="w-6 h-6 rounded" alt="Google" />
                <span class="font-bold text-lg">Google</span>
              </td>
              <td class="p-8 text-center text-red-400 font-medium">Masivo</td>
              <td class="p-8 text-center text-white/60">EE.UU.</td>
              <td class="p-8 text-center text-white/60">Propio</td>
              <td class="p-8 text-center">❌</td>
            </tr>
            <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
              <td class="p-8 flex items-center gap-4">
                <img src="https://www.google.com/s2/favicons?domain=bing.com&sz=64" class="w-6 h-6 rounded" alt="Bing" />
                <span class="font-bold text-lg">Bing</span>
              </td>
              <td class="p-8 text-center text-red-400 font-medium">Alto</td>
              <td class="p-8 text-center text-white/60">EE.UU.</td>
              <td class="p-8 text-center text-white/60">Propio</td>
              <td class="p-8 text-center">❌</td>
            </tr>
            <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
              <td class="p-8 flex items-center gap-4">
                <img src="https://www.google.com/s2/favicons?domain=duckduckgo.com&sz=64" class="w-6 h-6 rounded" alt="DDG" />
                <span class="font-bold text-lg">DuckDuckGo</span>
              </td>
              <td class="p-8 text-center text-green-400 font-medium">Mínimo</td>
              <td class="p-8 text-center text-white/60">EE.UU.*</td>
              <td class="p-8 text-center text-white/60">Bing / Propios</td>
              <td class="p-8 text-center">❌</td>
            </tr>
            <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
              <td class="p-8 flex items-center gap-4">
                <img src="https://www.google.com/s2/favicons?domain=ecosia.org&sz=64" class="w-6 h-6 rounded" alt="Ecosia" />
                <span class="font-bold text-lg">Ecosia</span>
              </td>
              <td class="p-8 text-center text-yellow-400 font-medium">Limitado</td>
              <td class="p-8 text-center text-white/60">Alemania</td>
              <td class="p-8 text-center text-white/60">Bing</td>
              <td class="p-8 text-center">✅</td>
            </tr>
            <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
              <td class="p-8 flex items-center gap-4">
                <img src="https://www.google.com/s2/favicons?domain=qwant.com&sz=64" class="w-6 h-6 rounded" alt="Qwant" />
                <span class="font-bold text-lg">Qwant</span>
              </td>
              <td class="p-8 text-center text-green-400 font-medium">Mínimo</td>
              <td class="p-8 text-center text-white/60">Francia</td>
              <td class="p-8 text-center text-white/60">Bing / Propio</td>
              <td class="p-8 text-center">✅</td>
            </tr>
            <tr class="bg-white/5">
              <td class="p-8 flex items-center gap-4">
                <img src="https://hosted.inled.es/start-simple-blanco-sinfondo.png" class="w-8 h-8 object-contain" alt="Start" />
                <span class="font-bold text-xl text-blue-400">Start</span>
              </td>
              <td class="p-8 text-center text-green-400 font-black text-lg">NINGUNO</td>
              <td class="p-8 text-center text-white font-bold">ESPAÑA</td>
              <td class="p-8 text-center text-white font-bold">MULTI-ÍNDICE</td>
              <td class="p-8 text-center text-lg">🇪🇸 ✅</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-[10px] text-white/30 text-center uppercase tracking-widest leading-relaxed">
        * Las sedes en EE.UU. están sujetas a leyes que pueden obligar a la entrega de datos incluso sin aviso al usuario. Start, bajo leyes españolas y europeas (RGPD), ofrece la máxima garantía legal de privacidad.
      </p>
    </section>

    <!-- Comparison Section -->
    <section class="w-full max-w-6xl px-6 py-20 z-10">
      <div class="glass-card p-12 md:p-20 rounded-[3rem] border border-white/10">
        <div class="max-w-3xl">
          <h2 class="text-3xl md:text-5xl font-black mb-8 tracking-tighter leading-tight">
            Todo lo que tiene la competencia,<br/>
            <span class="text-white/40">lo tenemos nosotros, </span>
            <span class="text-white italic">made in spain</span>.
          </h2>
          <p class="text-white/50 text-lg mb-12 font-light">
            No tienes que renunciar a nada. Start ofrece todas las herramientas esenciales con una capa de privacidad inquebrantable.
          </p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="flex flex-col items-center md:items-start gap-4">
            <div class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/60"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21 3 6"></polygon><line x1="9" y1="3" x2="9" y2="18"></line><line x1="15" y1="6" x2="15" y2="21"></line></svg>
            </div>
            <span class="font-bold uppercase tracking-widest text-[10px] text-white/80">Mapas</span>
          </div>
          <div class="flex flex-col items-center md:items-start gap-4">
            <div class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/60"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            </div>
            <span class="font-bold uppercase tracking-widest text-[10px] text-white/80">Imágenes</span>
          </div>
          <div class="flex flex-col items-center md:items-start gap-4">
            <div class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/60"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10l4 4v10a2 2 0 0 1-2 2z"></path><polyline points="14 4 14 8 18 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <span class="font-bold uppercase tracking-widest text-[10px] text-white/80">Noticias</span>
          </div>
          <div class="flex flex-col items-center md:items-start gap-4">
            <div class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/60"><path d="M12 2v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="M20 12h2"></path><path d="m19.07 19.07 1.41 1.41"></path><path d="M12 20v2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="M2 12h2"></path><path d="m4.93 19.07 1.41-1.41"></path><circle cx="12" cy="12" r="4"></circle></svg>
            </div>
            <span class="font-bold uppercase tracking-widest text-[10px] text-white/80">El Tiempo</span>
          </div>
        </div>

        <div class="mt-16 p-6 bg-white/5 rounded-2xl border border-white/5 text-center md:text-left">
          <p class="text-xs text-white/40 uppercase tracking-[0.2em] font-medium leading-relaxed">
            Vamos a añadir más funciones. Puedes consultar todas en <a href="https://inled.es" class="text-white/60 hover:text-white transition-colors">inled.es</a> <br>
            
          </p>
        </div>
      </div>
    </section>

    <!-- Search Now CTA -->
    <section class="w-full max-w-4xl px-6 py-20 z-10 text-center">
      <div class="glass-card p-12 md:p-20 rounded-[3rem] border border-white/10 relative overflow-hidden group">
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-white/5 rounded-full blur-3xl group-hover:bg-white/10 transition-all duration-700"></div>
        <div class="relative z-10">
          <h2 class="text-4xl md:text-5xl font-black mb-8 tracking-tighter">¿Listo para el cambio?</h2>
          <a href="/" class="inline-flex items-center gap-3 px-12 py-5 bg-white text-black font-black rounded-2xl hover:bg-white/90 transition-all hover:scale-105 active:scale-95 uppercase tracking-widest text-sm">
            Busca ya
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </section>

    <footer class="py-20 w-full max-w-6xl px-6 z-10">
      <div class="flex flex-col md:flex-row justify-between items-center gap-8 border-t border-white/10 pt-10">
        <div class="text-[10px] uppercase tracking-[0.3em] text-white/30">
          &copy; 2026 Inled Group | Made in España
        </div>
        <nav class="flex gap-8">
          <a href="/privacy" class="text-[10px] uppercase tracking-[0.2em] text-white/40 hover:text-white transition-colors">Privacidad</a>
          <a href="/cookies" class="text-[10px] uppercase tracking-[0.2em] text-white/40 hover:text-white transition-colors">Cookies</a>
          <a href="/terms" class="text-[10px] uppercase tracking-[0.2em] text-white/40 hover:text-white transition-colors">Términos</a>
        </nav>
      </div>
    </footer>

  </main>
</Layout>

<style>
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out forwards;
  }
  .animate-slide-up {
    opacity: 0;
    animation: slide-up 0.8s ease-out forwards;
  }
  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }
  
  html {
    scroll-behavior: smooth;
  }

  /* Scrollbar para la tabla en móviles */
  .overflow-x-auto::-webkit-scrollbar {
    height: 4px;
  }
  .overflow-x-auto::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }
</style>
