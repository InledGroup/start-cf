---
import '../styles/global.css';
import SearchAnimation from '../components/SearchAnimation.astro';

interface Props {
	title: string;
  description?: string;
  isHome?: boolean;
  image?: string;
  canonicalURL?: string;
}

const { 
  title, 
  description = "Start: El motor de búsqueda privado multi-índice hecho en España. Sin rastreo, sin cookies, solo resultados.",
  isHome = false,
  image = "https://hosted.inled.es/start-simple-blanco-sinfondo.png",
  canonicalURL = Astro.url.href
} = Astro.props;
const randomBg = `https://picsum.photos/1920/1080?random=${Math.random()}`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
    <!-- SEO Primario -->
    <title>{title} | Start Search</title>
    <meta name="title" content={`${title} | Start Search`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Start Search`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | Start Search`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;800;900&display=swap" rel="stylesheet">

    <!-- Datos Estructurados JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Start Search",
        "url": "https://start.es",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://start.es/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    <slot name="head" />
	</head>
	<body class={isHome ? "bg-black text-white" : "bg-white text-black"}>
    {isHome && (
      <div 
        class="fixed inset-0 -z-10 bg-cover bg-center transition-all duration-700 brightness-75 grayscale-[0.2]"
        style={`background-image: url('${randomBg}')`}
      >
        <div class="absolute inset-0 backdrop-blur-[2px] bg-black/20"></div>
      </div>
    )}
		<slot />
    <SearchAnimation />

    <!-- Toast Notification System -->
    <div id="toast-container" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-[200] flex flex-col gap-3 pointer-events-none"></div>

    <script is:inline>
      window.showToast = (message, type = 'info') => {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = 'px-6 py-3 rounded-2xl glass border border-white/20 text-white text-sm font-medium shadow-2xl transition-all duration-500 transform translate-y-10 opacity-0 pointer-events-auto flex items-center gap-3 min-w-[200px] justify-center';
        
        const icon = type === 'success' 
          ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-green-400"><polyline points="20 6 9 17 4 12"/></svg>'
          : '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';

        toast.innerHTML = `${icon} ${message}`;
        container.appendChild(toast);

        // Animar entrada
        setTimeout(() => {
          toast.classList.remove('translate-y-10', 'opacity-0');
        }, 10);

        // Auto-eliminar
        setTimeout(() => {
          toast.classList.add('translate-y-[-20px]', 'opacity-0');
          setTimeout(() => toast.remove(), 500);
        }, 3000);
      };

      window.shareApp = () => {
        const shareData = {
          title: 'Start Search',
          text: 'He descubierto este buscador privado hecho en España y está genial.',
          url: window.location.origin
        };
        
        if (navigator.share) {
          navigator.share(shareData).catch(err => {
            if (err.name !== 'AbortError') console.error(err);
          });
        } else {
          const copyToClipboard = (text) => {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              return navigator.clipboard.writeText(text);
            } else {
              const el = document.createElement('textarea');
              el.value = text;
              document.body.appendChild(el);
              el.select();
              document.execCommand('copy');
              document.body.removeChild(el);
              return Promise.resolve();
            }
          };

          copyToClipboard(shareData.url).then(() => {
            window.showToast('Enlace copiado al portapapeles', 'success');
          }).catch(() => {
            window.showToast('Error al copiar el enlace', 'error');
          });
        }
      };
    </script>
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
  
  /* Animación suave para la carga de imágenes de fondo */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  body {
    animation: fadeIn 0.5s ease-in;
  }
</style>
