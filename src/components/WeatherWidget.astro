---
---
<div id="weather-widget" class="md:absolute md:top-6 md:right-6 p-1 bg-transparent md:glass md:rounded-2xl text-white min-w-[120px] md:min-w-[180px] transition-all duration-500 transform translate-y-0 group/weather overflow-hidden">
  <!-- Estado inicial: Preguntar -->
  <div id="weather-prompt" class="flex flex-col items-center p-3 gap-2">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/60"><path d="M12 2v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="M20 12h2"/><path d="m19.07 19.07 1.41 1.41"/><path d="M12 20v2"/><path d="m6.34 17.66-1.41 1.41"/><path d="M2 12h2"/><path d="m4.93 19.07 1.41-1.41"/><circle cx="12" cy="12" r="4"/></svg>
      <span class="text-[10px] font-bold uppercase tracking-widest text-white/80">¿Ver el clima?</span>
    </div>
    <button id="btn-activate-weather" class="w-full py-1.5 bg-white/10 hover:bg-white/20 text-[9px] font-black uppercase tracking-tighter rounded-lg transition-all pointer-events-auto">
      Activar ubicación
    </button>
    <p class="text-[8px] text-white/40 leading-tight text-center">Solo local, nunca se envía a un servidor.</p>
  </div>

  <!-- Estado cargado: Clima -->
  <div id="weather-content" class="hidden flex items-center p-3 md:p-4 gap-3">
    <div id="weather-icon" class="text-2xl md:text-3xl">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin-slow"><circle cx="12" cy="12" r="4"/></svg>
    </div>
    <div class="text-left">
      <p id="temp" class="text-xl md:text-2xl font-semibold">--°</p>
      <p id="city" class="text-[10px] md:text-xs opacity-70 uppercase tracking-widest">Localizando...</p>
    </div>
  </div>
</div>

<script>
  function initWeather() {
    const prompt = document.getElementById('weather-prompt');
    const content = document.getElementById('weather-content');
    const btn = document.getElementById('btn-activate-weather');
    const tempEl = document.getElementById('temp');
    const cityEl = document.getElementById('city');

    if (!btn) return;

    async function getWeather() {
      if (!navigator.geolocation) {
        if (cityEl) cityEl.textContent = 'No soportado';
        return;
      }

      btn.textContent = 'Solicitando...';

      navigator.geolocation.getCurrentPosition(async (position) => {
        const { latitude, longitude } = position.coords;
        
        try {
          const response = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current_weather=true`);
          const data = await response.json();
          const weather = data.current_weather;
          
          if (tempEl) tempEl.textContent = `${Math.round(weather.temperature)}°`;
          if (cityEl) cityEl.textContent = 'Tu ubicación';
          
          prompt?.classList.add('hidden');
          content?.classList.remove('hidden');
          
          localStorage.setItem('weather_allowed', 'true');
        } catch (e) {
          if (cityEl) cityEl.textContent = 'Error API';
          btn.textContent = 'Error al cargar';
        }
      }, () => {
        btn.textContent = 'Permiso denegado';
        if (cityEl) cityEl.textContent = 'Bloqueado';
      });
    }

    if (localStorage.getItem('weather_allowed') === 'true') {
      getWeather();
    }

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      getWeather();
    });
  }

  // Ejecutar al cargar y en cada transición si es necesario
  initWeather();
  document.addEventListener('astro:page-load', initWeather);
</script>

<style>
  .animate-spin-slow {
    animation: spin 8s linear infinite;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
