---
interface Props {
  showLogo?: boolean;
  showTypes?: boolean;
  minimal?: boolean;
}

const { showLogo = true, showTypes = true, minimal = false } = Astro.props;
---
<div id="search-box-container" class={`w-full mx-auto px-4 transition-all duration-500 z-[100] ${minimal ? 'max-w-xl' : 'max-w-2xl'}`}>
  {showLogo && (
    <div id="search-logo" class="flex flex-col items-center mb-12 transition-all duration-500">
      <img 
        src="https://hosted.inled.es/start-simple-blanco-sinfondo.png" 
        alt="Start Logo" 
        class="h-14 md:h-20 object-contain drop-shadow-2xl"
      />
    </div>
  )}
  
  <form action="/search" method="GET" class="group flex flex-col gap-4" id="main-search-form">
    <div class="relative w-full">
      <input 
        type="text" 
        name="q" 
        id="search-input"
        placeholder="Busca en la web o imágenes..." 
        autocomplete="off"
        class={`w-full bg-white/10 backdrop-blur-2xl border border-white/20 text-white placeholder-white/40 rounded-2xl pl-6 pr-14 focus:outline-none focus:ring-1 focus:ring-white/40 transition-all duration-500 shadow-2xl group-hover:bg-white/15 ${minimal ? 'py-4 text-base' : 'py-5 text-lg'}`}
      />
      <button type="submit" class="absolute inset-y-0 right-0 w-16 flex items-center justify-center group/btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white/40 group-hover/btn:text-white transition-all duration-300"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
      </button>
    </div>

    <!-- Botón de búsqueda gigante para móvil (solo visible al enfocar) -->
    <button 
      type="button" 
      id="mobile-search-btn"
      class="hidden w-full py-5 bg-white text-black font-black rounded-2xl uppercase tracking-[0.2em] text-sm animate-slide-up shadow-2xl active:scale-95 transition-all pointer-events-auto"
    >
      Buscar ahora
    </button>

    {showTypes && (
      <div id="search-types" class="mt-8 flex justify-center gap-8 transition-all duration-500">
        <button 
          type="submit" 
          name="type" 
          value="web"
          class="text-white/60 hover:text-white text-sm font-medium tracking-widest uppercase transition-all hover:scale-105 active:scale-95"
        >
          Web
        </button>
        <div class="w-px h-4 bg-white/20 self-center"></div>
        <button 
          type="submit" 
          name="type" 
          value="images"
          class="text-white/60 hover:text-white text-sm font-medium tracking-widest uppercase transition-all hover:scale-105 active:scale-95"
        >
          Imágenes
        </button>
      </div>
    )}
  </form>
</div>

<script>
  function initSearchFocus() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const container = document.getElementById('search-box-container');
    const logo = document.getElementById('search-logo');
    const types = document.getElementById('search-types');
    const mobileBtn = document.getElementById('mobile-search-btn');
    const form = document.getElementById('main-search-form') as HTMLFormElement;

    if (!input || window.innerWidth >= 768) return;

    const handleFocus = () => {
      container?.classList.add('fixed', 'top-4', 'left-0', 'px-4', 'max-w-none');
      container?.classList.remove('max-w-xl', 'max-w-2xl');
      if (logo) logo.style.display = 'none';
      if (types) types.style.display = 'none';
      if (mobileBtn) mobileBtn.classList.remove('hidden');
      input.classList.remove('py-5');
      input.classList.add('py-3.5');
      document.body.classList.add('overflow-hidden');
      
      if (!document.getElementById('search-focus-overlay')) {
        const overlay = document.createElement('div');
        overlay.id = 'search-focus-overlay';
        overlay.className = 'fixed inset-0 bg-black/60 backdrop-blur-md z-[90] animate-fade-in';
        document.body.appendChild(overlay);
        overlay.addEventListener('click', () => input.blur());
      }
    };

    const handleBlur = (e: FocusEvent) => {
      // Usamos un pequeño delay para permitir que el click en el botón se procese
      setTimeout(() => {
        if (document.activeElement !== input && document.activeElement !== mobileBtn) {
          container?.classList.remove('fixed', 'top-4', 'left-0', 'px-4', 'max-w-none');
          container?.classList.add('max-w-2xl');
          if (logo) logo.style.display = 'flex';
          if (types) types.style.display = 'flex';
          if (mobileBtn) mobileBtn.classList.add('hidden');
          input.classList.remove('py-3.5');
          input.classList.add('py-5');
          document.body.classList.remove('overflow-hidden');
          document.getElementById('search-focus-overlay')?.remove();
        }
      }, 200);
    };

    input.addEventListener('focus', handleFocus);
    input.addEventListener('blur', handleBlur);
    
    mobileBtn?.addEventListener('click', () => {
      if (input.value.trim() !== '') {
        // Disparar evento de submit manualmente para que SearchAnimation lo capture
        const event = new Event('submit', { cancelable: true, bubbles: true });
        if (form.dispatchEvent(event)) {
          form.submit();
        }
      }
    });
  }

  initSearchFocus();
  document.addEventListener('astro:page-load', initSearchFocus);
</script>

<style>
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-slide-up {
    animation: slide-up 0.3s ease-out forwards;
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .animate-fade-in {
    animation: fade-in 0.3s ease-out forwards;
  }
</style>
